# ---- Contact form (server only — never exposed to the browser) ----
# Resend API key: https://resend.com/api-keys  (required for the form to send)
RESEND_API_KEY=
# Inbox that receives form messages
CONTACT_EMAIL=davidwork2184@gmail.com
# Verified sender. Leave empty to use Resend's test sender (onboarding@resend.dev),
# which only delivers to the email address your Resend account is registered with.
# After verifying your own domain in Resend: DAVID Portfolio <hello@yourdomain.com>
RESEND_FROM=

# ---- Public ----
# Address shown next to the form and used by mailto links (default: davidwork2184@gmail.com)
NEXT_PUBLIC_CONTACT_EMAIL=
# Public site address for metadata, sitemap and Open Graph. On Vercel the
# production domain is used automatically when this is empty.
NEXT_PUBLIC_SITE_URL=
